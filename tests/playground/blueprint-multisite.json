{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"features": { "networking": true },
	"login": true,
	"steps": [
		{
			"step": "defineWpConfigConsts",
			"consts": { "WP_DEBUG": true, "WP_DEBUG_DISPLAY": true }
		},
		{ "step": "enableMultisite" },
		{
			"step": "wp-cli",
			"command": "wp plugin activate plugins-last-updated-column plu-test-fake-wporg --network"
		}
	]
}
